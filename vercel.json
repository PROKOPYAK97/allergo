{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/media/:batchId/:kind", "destination": "/api/media?batchId=:batchId&kind=:kind" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
